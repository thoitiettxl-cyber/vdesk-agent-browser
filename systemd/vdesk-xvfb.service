# Template. install.sh replaces @VDESK_USER@ and @VDESK_GEOMETRY@.
# Not enabled at boot. `vdesk mode gui` starts it. Prefer a normal user.

[Unit]
Description=Xvfb :1

[Service]
User=@VDESK_USER@
ExecStart=/usr/bin/Xvfb :1 -screen 0 @VDESK_GEOMETRY@x24 -ac +extension GLX +render -noreset
Restart=always
RestartSec=2
