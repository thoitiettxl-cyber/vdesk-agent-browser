#!/usr/bin/env bash
# Launch the shared Chromium profile in the mode recorded by `vdesk`.
# CDP stays on 127.0.0.1:9222. --no-sandbox is added only when install.sh
# recorded a root service user. Do not point this process at another profile.
# Do not pass --headless or --enable-automation. --headless=new makes this
# Debian Chromium advertise HeadlessChrome, which bot checks treat as automation.
set -euo pipefail

CONFIG=/etc/vdesk/config
STATE=/var/lib/vdesk/mode
EXTRA=/etc/vdesk/chromium-extra

# shellcheck disable=SC1090
source "${CONFIG}"

: "${VDESK_HOME:?}"
: "${VDESK_WIDTH:?}"
: "${VDESK_HEIGHT:?}"

turnip_ready() {
  local config=/run/droidspaces/container.config
  local gpu_mode bin out
  [[ -f ${config} ]] || return 1
  gpu_mode=$(awk -F= '$1 == "enable_gpu_mode" { print $2; exit }' "${config}")
  [[ ${gpu_mode} == 1 ]] || return 1
  [[ -c /dev/kgsl-3d0 ]] || return 1
  for bin in vulkaninfo eglinfo; do
    command -v "${bin}" >/dev/null 2>&1 || continue
    if [[ ${bin} == vulkaninfo ]]; then
      out=$(timeout 8 env MESA_LOADER_DRIVER_OVERRIDE=kgsl TU_DEBUG=noconform vulkaninfo --summary 2>&1) || true
    else
      out=$(timeout 8 env MESA_LOADER_DRIVER_OVERRIDE=kgsl TU_DEBUG=noconform eglinfo -B 2>&1) || true
    fi
    if printf '%s\n' "${out}" | grep -qi turnip; then
      return 0
    fi
  done
  return 1
}

mode=headless
if [[ -f ${STATE} ]]; then
  mode=$(tr -d '[:space:]' < "${STATE}")
fi
if [[ ${mode} != gui ]]; then
  mode=headless
fi

limit=${VDESK_RENDERER_LIMIT:-2}
if [[ ! ${limit} =~ ^[1-9][0-9]*$ ]]; then
  limit=2
fi

bin=/usr/lib/chromium/chromium
if [[ ! -x ${bin} ]]; then
  bin=/usr/bin/chromium
fi

# Chromium reads TZ. /etc/localtime on this image is UTC, so the unit and
# this process both set the zone. Asia/Ho_Chi_Minh is the requested zone.
export TZ=Asia/Ho_Chi_Minh

# Call the real binary. /usr/bin/chromium prepends --load-extension from
# /etc/chromium.d, which would undo --disable-extensions. Headless adds
# --disable-gpu --disable-software-rasterizer; that pair used less RAM than
# --use-angle=swiftshader --enable-unsafe-swiftshader and still screenshots.
args=(
  --no-first-run
  --no-default-browser-check
  --user-data-dir="${VDESK_HOME}/.chromium-profile"
  --window-size="${VDESK_WIDTH},${VDESK_HEIGHT}"
  --remote-debugging-port=9222
  --remote-debugging-address=127.0.0.1
  --disable-extensions
  --disable-component-extensions-with-background-pages
  --disable-default-apps
  --disable-sync
  --disable-background-networking
  --disable-component-update
  --disable-domain-reliability
  --disable-breakpad
  --disable-client-side-phishing-detection
  --no-pings
  --metrics-recording-only
  "--disable-features=Translate,MediaRouter,OptimizationHints,InterestFeedContentSuggestions,BackForwardCache"
  --renderer-process-limit="${limit}"
  --process-per-site
  --disk-cache-size=33554432
  --media-cache-size=33554432
  --aggressive-cache-discard
)

if [[ ${VDESK_NO_SANDBOX:-0} == 1 ]]; then
  args+=(--no-sandbox)
fi

if [[ -f ${EXTRA} ]]; then
  while IFS= read -r line || [[ -n ${line} ]]; do
    case ${line} in
      ''|\#*) continue ;;
    esac
    case ${line} in
      --enable-automation|--enable-automation=*|--headless|--headless=*)
        printf 'vdesk-chromium: refusing %s; it marks the browser as automated\n' "${line}" >&2
        continue
        ;;
      -*) args+=("${line}") ;;
      *) printf 'vdesk-chromium: ignoring extra flag %s\n' "${line}" >&2 ;;
    esac
  done < "${EXTRA}"
fi

mkdir -p "${VDESK_HOME}/.chromium-profile"

if [[ ${mode} == gui ]]; then
  export DISPLAY=:1
  waited=0
  while [[ ! -S /tmp/.X11-unix/X1 ]]; do
    waited=$((waited + 1))
    if [[ ${waited} -gt 40 ]]; then
      printf 'vdesk-chromium: X socket /tmp/.X11-unix/X1 did not appear\n' >&2
      exit 1
    fi
    sleep 0.25
  done
  # VirGL injects GALLIUM_DRIVER=virpipe. It must not reach this process.
  unset GALLIUM_DRIVER || true
  if turnip_ready; then
    # kgsl selects Freedreno for /dev/kgsl-3d0. TU_DEBUG=noconform lets Turnip
    # advertise a usable Vulkan device. Set both before exec: Chromium clears
    # unknown variables after startup, and the zygote does not pass them to
    # the GPU process. The Vulkan ICD still binds Adreno without those
    # variables in the GPU process.
    # --use-gl=egl is rejected. --use-angle=gl initializes GLX and drops Xvfb.
    export MESA_LOADER_DRIVER_OVERRIDE=kgsl
    export TU_DEBUG=noconform
    args+=(--ozone-platform=x11 --window-position=0,0 --use-angle=vulkan)
    printf 'vdesk-chromium: gui renderer=turnip\n' >&2
  else
    unset MESA_LOADER_DRIVER_OVERRIDE TU_DEBUG || true
    args+=(--ozone-platform=x11 --window-position=0,0 --use-angle=swiftshader --enable-unsafe-swiftshader)
    printf 'vdesk-chromium: gui renderer=swiftshader\n' >&2
  fi
else
  unset DISPLAY || true
  # Ozone headless without --headless=new: screenshots still work, but the UA
  # stays Chrome/ instead of HeadlessChrome. Set the screen here; otherwise
  # Chromium defaults the headless screen to 800x600. SwiftShader WebGL was
  # far heavier on this host, so it stays off.
  args+=(
    --ozone-platform=headless
    --disable-gpu
    --disable-software-rasterizer
    --ozone-override-screen-size="${VDESK_WIDTH},${VDESK_HEIGHT}"
  )
fi

# After extra flags, so a profile file cannot drop these.
args+=(
  --lang=vi-VN
  --accept-lang=vi-VN,vi,en-US,en
  --disable-blink-features=AutomationControlled
  --force-device-scale-factor=1
)

exec /usr/bin/dbus-run-session -- "${bin}" "${args[@]}"
