# Template. install.sh replaces @VDESK_USER@, @VDESK_HOME@, @VDESK_WIDTH@, @VDESK_HEIGHT@.
# Do not add --no-sandbox unless the service user is root. install.sh adds it only then.
# CDP stays on 127.0.0.1:9222. Do not publish that port.

[Unit]
Description=Chromium on :1
Requires=vdesk-xvfb.service
After=vdesk-wm.service
PartOf=vdesk-xvfb.service

[Service]
User=@VDESK_USER@
Environment=DISPLAY=:1
ExecStartPre=/bin/sh -c 'until [ -S /tmp/.X11-unix/X1 ]; do sleep 0.5; done'
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/chromium --no-first-run --no-default-browser-check --user-data-dir=@VDESK_HOME@/.chromium-profile --window-size=@VDESK_WIDTH@,@VDESK_HEIGHT@ --remote-debugging-port=9222 --remote-debugging-address=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
