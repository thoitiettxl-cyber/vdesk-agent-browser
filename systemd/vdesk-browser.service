# Template. install.sh replaces @VDESK_USER@.
# Flags, profile, and headless/gui mode come from /usr/local/libexec/vdesk-chromium.
# Do not add --no-sandbox here. install.sh sets VDESK_NO_SANDBOX=1 only for root.
# CDP stays on 127.0.0.1:9222. Do not publish that port.

[Unit]
Description=Chromium CDP on 127.0.0.1:9222
After=vdesk-apply.service
Wants=vdesk-apply.service

[Service]
User=@VDESK_USER@
ExecStart=/usr/local/libexec/vdesk-chromium
Restart=always
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
