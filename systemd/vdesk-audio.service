# install.sh copies this only when the Droidspaces Pulse socket is present.

[Unit]
Description=Tune AAudio sink for music playback
After=local-fs.target
Before=vdesk-browser.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/vdesk-aaudio.sh

[Install]
WantedBy=multi-user.target
